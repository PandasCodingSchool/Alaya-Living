# Core
DATABASE_URL=postgresql://fmr:fmr@localhost:5432/findmyroommate
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-change-me
PORT=4000
NODE_ENV=development

# CORS — comma-separated web origins (required in production)
WEB_ORIGIN=http://localhost:3000,http://localhost:3001
API_PUBLIC_URL=http://localhost:4000

# Object storage (MinIO local / S3 production)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000/fmr-uploads
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=fmr-uploads
S3_REGION=ap-south-1

# Email (Resend) — logs to console if unset
RESEND_API_KEY=
EMAIL_FROM=Alaya <onboarding@resend.dev>

# SMS — MSG91 (India) or Twilio; dev uses code 123456
MSG91_AUTH_KEY=
MSG91_SENDER=ALAYAA
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Payments (Razorpay) — demo mode if unset
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Geocoding (Nominatim fair-use)
GEOCODE_USER_AGENT=FindMyRoommate/1.0 (dev@findmyroommate.local)
